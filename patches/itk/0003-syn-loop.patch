+  /** Each SyN iteration evaluates the metric twice with the roles of the two images swapped,
+   * so with DownsampleImagesForMetricDerivatives it resamples the same (image, transform)
+   * pairs twice. These caches let the second evaluation reuse the first one's results. They
+   * are only valid within one iteration and are cleared at the start and end of each. */
+  void
+  ClearResampleCache();
+
 private:
   RealType m_GaussianSmoothingVarianceForTheUpdateField{ 3.0 };
   RealType m_GaussianSmoothingVarianceForTheTotalField{ 0.5 };
+
+  template <typename TResult>
+  struct ResampleCacheEntry
+  {
+    const void * source{ nullptr };
+    const void * transform{ nullptr };
+    TResult      result{};
+  };
+  std::vector<ResampleCacheEntry<typename FixedImageType::Pointer>>              m_ResampledImageCache{};
+  std::vector<ResampleCacheEntry<typename ImageMaskSpatialObjectType::Pointer>> m_ResampledMaskCache{};
+  /** Only SyN's own StartOptimization clears the caches per iteration, so only it turns them on
+   * (subclasses with their own loops, e.g. BSplineSyN, keep resampling every call). */
+  bool m_UseResampleCache{ false };
+
+  /** Zero displacement field transform on the current virtual domain, reused across metric calls. */
+  DisplacementFieldTransformPointer m_IdentityDisplacementFieldTransform{};
 };
 } // end namespace itk
 
