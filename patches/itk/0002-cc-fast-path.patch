+/** True if the transform is a displacement field transform whose field is all zeros, i.e. the identity. */
+template <typename TTransform>
+bool
+IsZeroDisplacementFieldTransform(const TTransform * transform, MultiThreaderBase * threader)
+{
+  using DisplacementFieldTransformType =
+    DisplacementFieldTransform<typename TTransform::ParametersValueType, TTransform::InputSpaceDimension>;
+  const auto * dft = dynamic_cast<const DisplacementFieldTransformType *>(transform);
+  if (dft == nullptr)
+  {
+    return false;
+  }
+  const auto * field = dft->GetDisplacementField();
+  if (field == nullptr || field->GetBufferPointer() == nullptr)
+  {
+    return false;
+  }
+  using ValueType = typename DisplacementFieldTransformType::DisplacementFieldType::PixelType::ValueType;
+  const auto *        values = reinterpret_cast<const ValueType *>(field->GetBufferPointer());
+  const SizeValueType count = field->GetBufferedRegion().GetNumberOfPixels() * TTransform::InputSpaceDimension;
+  constexpr SizeValueType chunks = 256;
+  std::atomic<bool>       nonzero{ false };
+  threader->ParallelizeArray(
+    0,
+    chunks,
+    [&](SizeValueType chunk) {
+      const SizeValueType begin = count * chunk / chunks;
+      const SizeValueType end = count * (chunk + 1) / chunks;
+      for (SizeValueType i = begin; i < end; ++i)
+      {
+        if (!(values[i] == ValueType{}))
+        {
+          nonzero = true;
+          return;
+        }
+      }
+    },
+    nullptr);
+  return !nonzero;
+}
