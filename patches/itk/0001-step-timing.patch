diff --git a/Modules/Registration/RegistrationMethodsv4/include/itkStepProfiler.h b/Modules/Registration/RegistrationMethodsv4/include/itkStepProfiler.h
new file mode 100644
index 0000000..a199f79
--- /dev/null
+++ b/Modules/Registration/RegistrationMethodsv4/include/itkStepProfiler.h
@@ -0,0 +1,178 @@
+/*=========================================================================
+ *
+ *  Profiling instrumentation for the SyN registration loop. Not part of upstream ITK.
+ *
+ *  ANTS_STEP_TIMING=1  print per-level wall time and call counts per step to stderr:
+ *                        [step] level=L name=NAME calls=N wall_s=S
+ *  ANTS_STEP_TRACE=1   also print a begin/end marker per call, for lining up an
+ *                      external memory poller:  [step+] NAME T  /  [step-] NAME T
+ *
+ *  With neither variable set every scope is a branch on a cached bool, and nothing is
+ *  printed, so registration output is unchanged.
+ *
+ *=========================================================================*/
+#ifndef itkStepProfiler_h
+#define itkStepProfiler_h
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace itk
+{
+namespace step_profiler
+{
+
+struct Totals
+{
+  double             seconds{ 0.0 };
+  unsigned long long calls{ 0 };
+};
+
+inline bool
+EnvFlag(const char * name)
+{
+  const char * v = std::getenv(name);
+  return v != nullptr && *v != '\0' && *v != '0';
+}
+
+inline bool
+Enabled()
+{
+  static const bool on = EnvFlag("ANTS_STEP_TIMING") || EnvFlag("ANTS_STEP_TRACE");
+  return on;
+}
+
+inline bool
+Trace()
+{
+  static const bool on = EnvFlag("ANTS_STEP_TRACE");
+  return on;
+}
+
+inline double
+Now()
+{
+  using Clock = std::chrono::steady_clock;
+  static const Clock::time_point start = Clock::now();
+  return std::chrono::duration<double>(Clock::now() - start).count();
+}
+
+inline std::mutex &
+Mutex()
+{
+  static std::mutex m;
+  return m;
+}
+
+// std::map keeps the report order stable, which makes runs easy to diff.
+inline std::map<std::string, Totals> &
+Table()
+{
+  static std::map<std::string, Totals> t;
+  return t;
+}
+
+inline std::map<unsigned int, unsigned long long> &
+InverterHistogram()
+{
+  static std::map<unsigned int, unsigned long long> h;
+  return h;
+}
+
+class Scope
+{
+public:
+  explicit Scope(const char * name)
+    : m_Name(name)
+    , m_Active(Enabled())
+  {
+    if (m_Active)
+    {
+      m_Start = Now();
+      if (Trace())
+      {
+        std::fprintf(stderr, "[step+] %s %.6f\n", m_Name, m_Start);
+        std::fflush(stderr);
+      }
+    }
+  }
+
+  ~Scope() { Stop(); }
+
+  Scope(const Scope &) = delete;
+  Scope &
+  operator=(const Scope &) = delete;
+
+  void
+  Stop()
+  {
+    if (!m_Active)
+    {
+      return;
+    }
+    m_Active = false;
+    const double end = Now();
+    if (Trace())
+    {
+      std::fprintf(stderr, "[step-] %s %.6f\n", m_Name, end);
+      std::fflush(stderr);
+    }
+    const std::lock_guard<std::mutex> lock(Mutex());
+    Totals &                          t = Table()[m_Name];
+    t.seconds += end - m_Start;
+    ++t.calls;
+  }
+
+private:
+  const char * m_Name;
+  bool         m_Active;
+  double       m_Start{ 0.0 };
+};
+
+inline void
+RecordInverterIterations(unsigned int iterations)
+{
+  if (!Enabled())
+  {
+    return;
+  }
+  const std::lock_guard<std::mutex> lock(Mutex());
+  ++InverterHistogram()[iterations];
+}
+
+// Prints and clears everything accumulated since the last report.
+inline void
+Report(const char * level, unsigned long long voxels, unsigned int workUnits, unsigned int threads)
+{
+  if (!Enabled())
+  {
+    return;
+  }
+  const std::lock_guard<std::mutex> lock(Mutex());
+  std::fprintf(stderr, "[step] level=%s voxels=%llu work_units=%u threads=%u\n", level, voxels, workUnits, threads);
+  for (const auto & entry : Table())
+  {
+    std::fprintf(stderr,
+                 "[step] level=%s name=%s calls=%llu wall_s=%.6f\n",
+                 level,
+                 entry.first.c_str(),
+                 entry.second.calls,
+                 entry.second.seconds);
+  }
+  for (const auto & entry : InverterHistogram())
+  {
+    std::fprintf(stderr, "[step] level=%s inverter_iterations=%u count=%llu\n", level, entry.first, entry.second);
+  }
+  std::fflush(stderr);
+  Table().clear();
+  InverterHistogram().clear();
+}
+
+} // namespace step_profiler
+} // namespace itk
+
+#endif
